{
  "name": { "en": "Stone Connect Heater" },
  "class": "heater",
  "capabilities": [
    "onoff",
    "target_temperature",
    "boost_duration",
    "measure_power",
    "meter_power",
    "alarm_generic"
  ],
  "capabilitiesOptions": {
    "target_temperature": {
      "min": 5,
      "max": 30,
      "step": 0.5
    }
  },
  "platforms": ["local"],
  "connectivity": ["lan"],
  "images": {
    "small": "/drivers/heater/assets/images/small.png",
    "large": "/drivers/heater/assets/images/large.png",
    "xlarge": "/drivers/heater/assets/images/xlarge.png"
  },
  "pair": [
    {
      "id": "manual_ip",
      "navigation": { "next": "list_devices" }
    },
    {
      "id": "list_devices",
      "template": "list_devices",
      "navigation": { "next": "add_devices" }
    },
    {
      "id": "add_devices",
      "template": "add_devices"
    }
  ],
  "settings": [
    {
      "id": "host",
      "type": "text",
      "label": { "en": "IP Address" },
      "value": ""
    },
    {
      "id": "port",
      "type": "number",
      "label": { "en": "Port" },
      "value": 443,
      "min": 1,
      "max": 65535
    },
    {
      "id": "poll_interval",
      "type": "number",
      "label": { "en": "Poll Interval (seconds)" },
      "value": 30,
      "min": 5,
      "max": 600
    }
  ]
}
