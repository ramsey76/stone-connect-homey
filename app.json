{
  "_comment": "This file is generated. Please edit .homeycompose/app.json instead.",
  "id": "com.arnomclean.stoneconnect",
  "version": "1.1.1",
  "compatibility": ">=13.0.0",
  "sdk": 3,
  "runtime": "python",
  "pythonVersion": "3.14",
  "platforms": [
    "local"
  ],
  "name": {
    "en": "Stone Connect"
  },
  "description": {
    "en": "Control your electric bathroom heater over Wi-Fi, with boost and preset modes."
  },
  "category": [
    "climate"
  ],
  "brandColor": "#D94F2A",
  "permissions": [],
  "images": {
    "small": "/assets/images/small.png",
    "large": "/assets/images/large.png",
    "xlarge": "/assets/images/xlarge.png"
  },
  "author": {
    "name": "Arno McLean",
    "email": "arno.mclean@gmail.com"
  },
  "pythonPackages": [
    "aiohttp"
  ],
  "flow": {
    "actions": [
      {
        "id": "activate_boost",
        "title": {
          "en": "Activate Boost"
        },
        "titleFormatted": {
          "en": "Activate Boost for [[minutes]] minutes"
        },
        "hint": {
          "en": "Runs the heater flat-out for the given number of minutes (max 120). Afterwards the heater returns to its previous mode."
        },
        "args": [
          {
            "type": "device",
            "name": "device",
            "filter": "driver_id=heater"
          },
          {
            "type": "number",
            "name": "minutes",
            "title": {
              "en": "Duration (minutes)"
            },
            "min": 30,
            "max": 120,
            "step": 1,
            "placeholder": {
              "en": "120"
            }
          }
        ]
      },
      {
        "id": "set_heater_mode",
        "title": {
          "en": "Set heater mode"
        },
        "titleFormatted": {
          "en": "Set mode to [[mode]]"
        },
        "hint": {
          "en": "Switches the heater to one of its preset or power modes. Use the on/off card to put it on standby."
        },
        "args": [
          {
            "type": "device",
            "name": "device",
            "filter": "driver_id=heater"
          },
          {
            "type": "dropdown",
            "name": "mode",
            "title": {
              "en": "Mode"
            },
            "values": [
              {
                "id": "CMF",
                "label": {
                  "en": "Comfort"
                }
              },
              {
                "id": "ECO",
                "label": {
                  "en": "Eco"
                }
              },
              {
                "id": "ANF",
                "label": {
                  "en": "Antifreeze"
                }
              },
              {
                "id": "MAN",
                "label": {
                  "en": "Manual"
                }
              },
              {
                "id": "HIG",
                "label": {
                  "en": "High"
                }
              },
              {
                "id": "MED",
                "label": {
                  "en": "Medium"
                }
              },
              {
                "id": "LOW",
                "label": {
                  "en": "Low"
                }
              }
            ]
          }
        ]
      }
    ]
  },
  "drivers": [
    {
      "name": {
        "en": "Stone Connect Heater"
      },
      "class": "heater",
      "capabilities": [
        "onoff",
        "target_temperature",
        "boost_duration",
        "measure_power",
        "meter_power",
        "alarm_generic"
      ],
      "capabilitiesOptions": {
        "target_temperature": {
          "min": 5,
          "max": 30,
          "step": 0.5
        }
      },
      "platforms": [
        "local"
      ],
      "connectivity": [
        "lan"
      ],
      "images": {
        "small": "/drivers/heater/assets/images/small.png",
        "large": "/drivers/heater/assets/images/large.png",
        "xlarge": "/drivers/heater/assets/images/xlarge.png"
      },
      "pair": [
        {
          "id": "manual_ip",
          "navigation": {
            "next": "list_devices"
          }
        },
        {
          "id": "list_devices",
          "template": "list_devices",
          "navigation": {
            "next": "add_devices"
          }
        },
        {
          "id": "add_devices",
          "template": "add_devices"
        }
      ],
      "settings": [
        {
          "id": "host",
          "type": "text",
          "label": {
            "en": "IP Address"
          },
          "value": ""
        },
        {
          "id": "port",
          "type": "number",
          "label": {
            "en": "Port"
          },
          "value": 443,
          "min": 1,
          "max": 65535
        },
        {
          "id": "poll_interval",
          "type": "number",
          "label": {
            "en": "Poll Interval (seconds)"
          },
          "value": 30,
          "min": 5,
          "max": 600
        }
      ],
      "id": "heater"
    }
  ],
  "capabilities": {
    "boost_duration": {
      "type": "number",
      "title": {
        "en": "Boost"
      },
      "icon": "/assets/boost.svg",
      "uiComponent": "slider",
      "getable": true,
      "setable": true,
      "min": 0,
      "max": 120,
      "step": 30,
      "units": {
        "en": "min"
      },
      "insights": false
    }
  }
}